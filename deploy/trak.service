[Unit]
Description=Trak Task & Discipline Daemon
After=network.target

[Service]
Type=simple
User=trak
Group=trak
WorkingDirectory=/var/lib/trak
EnvironmentFile=/etc/trak/trak.env
ExecStart=/usr/local/bin/trak
Restart=always
RestartSec=5s

# Systemd Hardening & Sandboxing
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/trak
PrivateTmp=true
NoNewPrivileges=true
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
