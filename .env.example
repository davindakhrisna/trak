# Trak Environment Configuration
# Copy this file to /etc/trak/trak.env or .env

# Server Binding
LEPTOS_SITE_ADDR=127.0.0.1:3000
LEPTOS_ENV=PROD

# Database Path
DATABASE_URL=sqlite:///var/lib/trak/trak.db

# JWT Secret for Session Authentication (generate a secure random 32+ char string)
JWT_SECRET=replace_with_a_long_cryptographically_secure_random_key_min_32_chars
